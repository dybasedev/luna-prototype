# Luna Prototype 测试环境配置示例
# 复制此文件为 .env.testing 并根据您的环境修改配置

APP_ENV=testing
APP_KEY=base64:YOUR_APP_KEY_HERE
APP_DEBUG=true

# MySQL测试数据库配置
DB_TEST_HOST=127.0.0.1
DB_TEST_PORT=3306
DB_TEST_DATABASE=luna_prototype_test
DB_TEST_USERNAME=root
DB_TEST_PASSWORD=root

# 缓存配置
CACHE_STORE=array

# 测试优化配置
BCRYPT_ROUNDS=4
MAIL_MAILER=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array

# 日志配置
LOG_CHANNEL=single
LOG_LEVEL=debug